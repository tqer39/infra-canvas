diagram "EKS 単一アカウント・複数クラスター" version=1 {
account workload "Workload Account" {
vpc net "Workload VPC" {
aws.eks cluster_a "EKS cluster_a" {
  k8s.namespace cluster_a_a_ns "Namespace A" {
    k8s.ingress cluster_a_a_ingress "Ingress A"
    k8s.service cluster_a_a_service "Service A"
    k8s.pod cluster_a_a_pod "Pod A"
    k8s.service-account cluster_a_a_sa "ServiceAccount A"
  }
  k8s.namespace cluster_a_admin "Admin Namespace" {
    k8s.deployment cluster_a_gitops "GitOps controller"
  }
}
aws.eks cluster_b "EKS cluster_b" {
  k8s.namespace cluster_b_b_ns "Namespace B" {
    k8s.ingress cluster_b_b_ingress "Ingress B"
    k8s.service cluster_b_b_service "Service B"
    k8s.pod cluster_b_b_pod "Pod B"
    k8s.service-account cluster_b_b_sa "ServiceAccount B"
  }
  k8s.namespace cluster_b_admin "Admin Namespace" {
    k8s.deployment cluster_b_gitops "GitOps controller"
  }
}
aws.rds db_a "DB A"
aws.rds db_b "DB B"
}
}
cluster_a_a_ingress -> cluster_a_a_service kind=traffic label="Ingress の転送先"
cluster_a_a_service -> cluster_a_a_pod kind=traffic label="Service の対象"
cluster_a_a_pod -> cluster_a_a_sa kind=auth label="ServiceAccount の利用"
cluster_b_b_ingress -> cluster_b_b_service kind=traffic label="Ingress の転送先"
cluster_b_b_service -> cluster_b_b_pod kind=traffic label="Service の対象"
cluster_b_b_pod -> cluster_b_b_sa kind=auth label="ServiceAccount の利用"
cluster_a_a_pod -> db_a kind=traffic label="A のデータアクセス意図"
cluster_b_b_pod -> db_b kind=traffic label="B のデータアクセス意図"
view overview level=overview
view service level=service
view network level=subnet
view security level=resource overlay=sg
}
