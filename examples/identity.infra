# 表示検証用の架空ID・AZ割り当てです。実アカウントの対応関係を示しません。
diagram "アカウント・リージョン・AZの識別情報" version=1 {
  account prod "本番アカウント" account="012345678901" {
    region tokyo "東京" region="ap-northeast-1" {
      vpc main "本番 VPC" cidr="10.0.0.0/16" {
        subnet private_a "アプリ Subnet" private az="ap-northeast-1a" azId="apne1-az1" cidr="10.0.10.0/24"
        aws.ecs api "API" subnets=[private_a]
      }
    }
  }
  project google "Google Cloud" project="demo-project" {
    network google_vpc "VPC（global）" {
      subnet google_subnet "東京 Subnet" region="asia-northeast1" cidr="10.20.0.0/24"
      gcp.compute compute "Compute Engine" az="asia-northeast1-a"
    }
  }
  subscription azure "Azure" subscription="00000000-0000-0000-0000-000000000001" {
    azure.vm vm "Virtual Machine" region="japaneast"
  }
  api -> compute kind=association label="設計上の関係"
  view overview level=overview
  view service level=service
  view network level=subnet
}
