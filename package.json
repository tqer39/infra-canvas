{
  "name": "infra-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "独自 DSL と Terraform から対話型のインフラ構成図を生成します",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "infra-canvas": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/library/core/index.d.ts",
      "import": "./dist/library/core/index.js"
    },
    "./terraform": {
      "types": "./dist/library/terraform/index.d.ts",
      "import": "./dist/library/terraform/index.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings . && node scripts/lint-markdown.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "cli": "node --import tsx src/cli.ts",
    "check": "npm run typecheck && npm run lint && npm run fmt:check && npm test && npm run test:icons && npm run build",
    "test:browser": "playwright test",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "icons:update": "python3 scripts/update-icons.py",
    "icons:check": "python3 scripts/update-icons.py --check",
    "test:icons": "python3 tests/update-icons.test.py"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "markdownlint": "0.41.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
