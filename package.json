{
  "name": "infra-canvas",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "独自 DSL と Terraform から対話型のインフラ構成図を生成します",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "infra-canvas": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/library/core/index.d.ts",
      "import": "./dist/library/core/index.js"
    },
    "./terraform": {
      "types": "./dist/library/terraform/index.d.ts",
      "import": "./dist/library/terraform/index.js"
    }
  },
  "scripts": {
    "dev": "mise run dev",
    "typecheck": "mise run typecheck",
    "lint": "mise run lint",
    "test": "mise run test",
    "build": "mise run build",
    "cli": "mise run cli",
    "check:static": "mise run check:static",
    "check": "mise run check",
    "test:browser": "mise run test:browser",
    "fmt": "mise run fmt",
    "fmt:check": "mise run fmt:check",
    "icons:update": "mise run icons:update",
    "icons:check": "mise run icons:check",
    "test:icons": "mise run test:icons"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1151.0",
    "@mlc-ai/web-llm": "0.2.86",
    "@napi-rs/keyring": "2.1.1",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "markdownlint": "0.41.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsx": "4.23.15",
    "vite": "8.3.4"
  },
  "overrides": {
    "katex": "0.19.0"
  }
}
