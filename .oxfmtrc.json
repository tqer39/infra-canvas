{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "artifacts/**",
    "examples/**",
    "src/assets/*.svg",
    "src/assets/manifest.json",
    "docs/screenshots/**",
    "package-lock.json"
  ]
}
