# Copy to .env.llm and load it in the local Node.js server. Never use a VITE_ prefix.
# Chat Completions-compatible API (fill all three to enable)
INFRA_LLM_API_BASE_URL=
INFRA_LLM_API_MODEL=
INFRA_LLM_API_KEY=
# Set to off if the API/model does not accept response_format: json_object.
INFRA_LLM_API_JSON_MODE=on

# Amazon Bedrock: a Converse-compatible model ID or inference profile ID/ARN
INFRA_LLM_BEDROCK_MODEL=
# Use existing AWS credentials/SSO profiles; do not put keys in browser settings.
# AWS_PROFILE=your-profile
# AWS_REGION=ap-northeast-1

# Per-call output limit, shared by external providers (256..16384)
INFRA_LLM_MAX_TOKENS=4096

# Optional: dedicated directory for non-secret persistent UI settings.
# API keys are stored in the OS credential store, never in this directory.
# OMNODI_LLM_CONFIG_DIR=/absolute/path/to/private/omnodi-settings
# Legacy INFRA_LLM_CONFIG_DIR is also supported.
